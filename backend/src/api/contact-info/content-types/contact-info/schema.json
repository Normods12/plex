{
  "kind": "collectionType",
  "collectionName": "contact_infos",
  "info": {
    "singularName": "contact-info",
    "pluralName": "contact-infos",
    "displayName": "Contact Info",
    "description": "Company contact details displayed site-wide"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "enumeration",
      "enum": [
        "plexonics",
        "dripx",
        "milestone"
      ],
      "required": true,
      "default": "plexonics"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "mapEmbed": {
      "type": "text"
    },
    "contactFormTarget": {
      "type": "string"
    }
  }
}
