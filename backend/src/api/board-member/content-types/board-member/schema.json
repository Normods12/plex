{
  "kind": "collectionType",
  "collectionName": "board_members",
  "info": {
    "singularName": "board-member",
    "pluralName": "board-members",
    "displayName": "Board Member",
    "description": "Board of Directors profiles for Milestone Furniture — required for BSE SME corporate governance disclosure"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "brand": {
      "type": "enumeration",
      "enum": ["plexonics", "dripx", "milestone"],
      "required": true,
      "default": "milestone"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "designation": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["executive", "non-executive", "independent", "nominee"],
      "required": true,
      "default": "independent"
    },
    "din": {
      "type": "string"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "bio": {
      "type": "blocks"
    },
    "qualifications": {
      "type": "text"
    },
    "experience": {
      "type": "text"
    },
    "committees": {
      "type": "json"
    },
    "linkedinUrl": {
      "type": "string"
    },
    "joinDate": {
      "type": "date"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
